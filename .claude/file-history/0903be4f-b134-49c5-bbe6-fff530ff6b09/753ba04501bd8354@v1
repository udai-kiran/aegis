# Development overrides - exposes service ports to host for debugging
# This file is auto-loaded by docker compose alongside docker-compose.yml

services:
  postgres:
    ports:
      - "5432:5432"

  redis:
    ports:
      - "6379:6379"

  minio:
    ports:
      - "9000:9000"
      - "9001:9001"

  api-gateway:
    ports:
      - "8000:8000"
    environment:
      LOG_LEVEL: debug
